# Authored on Windows, consumed on Linux (WSL, PetaLinux, the board itself).
# Force LF so shell scripts keep a working #! line and Tcl/device tree sources
# do not pick up stray carriage returns.
* text=auto eol=lf

*.sh      text eol=lf
*.tcl     text eol=lf
*.dts     text eol=lf
*.dtsi    text eol=lf
*.sv      text eol=lf
*.svh     text eol=lf
*.v       text eol=lf
*.vh      text eol=lf
*.xdc     text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.py      text eol=lf
Makefile  text eol=lf

# Batch files are the exception: cmd.exe wants CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Machine-generated by the Xilinx tools. Kept because the boot chain does not
# work without them, but excluded from diffs and language statistics: they are
# ~2.5 MB of register writes, not authored code.
linux/board/aup-zu3/psu_init_gpl.c linguist-generated=true
linux/board/aup-zu3/psu_init_gpl.h linguist-generated=true
linux/dts/zynqmp.dtsi              linguist-generated=true
linux/dts/zynqmp-clk-ccf.dtsi      linguist-generated=true
linux/dts/include/**               linguist-generated=true

# Binary, never touched.
*.bit     binary
*.bin     binary
*.xsa     binary
*.bsp     binary
*.png     binary
*.jpg     binary
*.pdf     binary
